# DeskScrolls – environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Supabase (required) ---
# Project URL and anon (public) key from Supabase > Project Settings > API.
# Both are exposed to the browser; all write access MUST be protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- ImageKit (required for /submit image uploads, see app/actions/uploadMedia.ts) ---
# Server-only. Never prefix these with NEXT_PUBLIC_.
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# --- Site ---
# Used by sitemap/robots/canonical URLs (see docs/AUDIT_REPORT.md if this is still hardcoded).
NEXT_PUBLIC_SITE_URL=https://deskscroll.com
